<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- ===== HEADER BIRU ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1565C0"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Laporan Presensi"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filter data berdasarkan rentang tanggal"
            android:textSize="12sp"
            android:textColor="#90CAF9"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- ===== FILTER TANGGAL ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="2dp"
        android:layout_marginBottom="8dp">

        <!-- Input tanggal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dari"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="2dp" />

                <EditText
                    android:id="@+id/etTanggalMulai"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="yyyy-MM-dd"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#BBBBBB"
                    android:textSize="14sp"
                    android:background="#F5F5F5"
                    android:paddingHorizontal="12dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sampai"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="2dp" />

                <EditText
                    android:id="@+id/etTanggalAkhir"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="yyyy-MM-dd"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#BBBBBB"
                    android:textSize="14sp"
                    android:background="#F5F5F5"
                    android:paddingHorizontal="12dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Tombol shortcut tanggal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnMingguIni"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Minggu Ini"
                android:textSize="12sp"
                android:backgroundTint="#E3F2FD"
                android:textColor="#1565C0"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnBulanIni"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Bulan Ini"
                android:textSize="12sp"
                android:backgroundTint="#E3F2FD"
                android:textColor="#1565C0"
                android:layout_marginStart="6dp" />

        </LinearLayout>

        <!-- Tombol tampilkan -->
        <Button
            android:id="@+id/btnTampilkan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Tampilkan Laporan"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#1565C0" />

    </LinearLayout>

    <!-- ===== AREA HASIL (Scrollable) ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/containerLaporan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <!-- ===== FOOTER EXPORT ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="8dp">

        <Button
            android:id="@+id/btnExportCsv"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Export CSV"
            android:textSize="13sp"
            android:backgroundTint="#2E7D32"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnExportPdf"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Export PDF"
            android:textSize="13sp"
            android:backgroundTint="#C62828"
            android:layout_marginStart="6dp" />

    </LinearLayout>

</LinearLayout>