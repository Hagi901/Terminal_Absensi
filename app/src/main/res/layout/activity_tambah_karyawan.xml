<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1565C0"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tambah Karyawan Baru"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Isi data lalu ambil sampel wajah dari 3 sudut"
            android:textSize="12sp"
            android:textColor="#90CAF9"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Kartu form data -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data Karyawan"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:layout_marginBottom="12dp" />

                <!-- ID -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID Karyawan"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etIdKaryawan"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Contoh: K001"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#BBBBBB"
                    android:textSize="15sp"
                    android:background="#F5F5F5"
                    android:paddingHorizontal="12dp"
                    android:inputType="text"
                    android:layout_marginBottom="12dp" />

                <!-- Nama -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama Lengkap"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etNama"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Nama lengkap karyawan"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#BBBBBB"
                    android:textSize="15sp"
                    android:background="#F5F5F5"
                    android:paddingHorizontal="12dp"
                    android:inputType="textPersonName"
                    android:layout_marginBottom="12dp" />

                <!-- Jabatan -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jabatan (opsional)"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etJabatan"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Jabatan atau divisi"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#BBBBBB"
                    android:textSize="15sp"
                    android:background="#F5F5F5"
                    android:paddingHorizontal="12dp"
                    android:inputType="text" />

            </LinearLayout>

            <!-- Kartu kamera -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sampel Wajah"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:layout_marginBottom="12dp" />

                <!-- Preview kamera -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:background="@android:color/black">

                    <androidx.camera.view.PreviewView
                        android:id="@+id/previewView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/tvInstruksi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="#CC000000"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp"
                        android:text="Isi data lalu tekan Ambil Sampel"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:gravity="center" />

                </FrameLayout>

                <!-- Progress sampel -->
                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sampel: 0/3"
                    android:textColor="#1565C0"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <!-- Tombol ambil sampel -->
                <Button
                    android:id="@+id/btnAmbilSampel"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Ambil Sampel Wajah"
                    android:textSize="14sp"
                    android:backgroundTint="#42A5F5"
                    android:layout_marginBottom="8dp" />

                <!-- Tombol simpan -->
                <Button
                    android:id="@+id/btnSimpan"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Simpan Karyawan"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="#2E7D32"
                    android:enabled="false" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>