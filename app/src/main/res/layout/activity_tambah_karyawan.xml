<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tambah Karyawan Baru"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etIdKaryawan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ID Karyawan"
            android:textColor="@android:color/black"
            android:textColorHint="#888888"
            android:background="#F0F0F0"
            android:padding="12dp"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etNama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama Lengkap"
            android:textColor="@android:color/black"
            android:textColorHint="#888888"
            android:background="#F0F0F0"
            android:padding="12dp"
            android:inputType="textPersonName"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etJabatan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Jabatan (opsional)"
            android:textColor="@android:color/black"
            android:textColorHint="#888888"
            android:background="#F0F0F0"
            android:padding="12dp"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:background="@android:color/black">

            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tvInstruksi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_margin="16dp"
                android:background="#80000000"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="Isi data lalu tekan Ambil Sampel"
                android:textColor="@android:color/white" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sampel: 0/3"
            android:textColor="@android:color/black"
            android:textAlignment="center"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnAmbilSampel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ambil Sampel Wajah"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnSimpan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simpan Karyawan"
            android:enabled="false"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>