<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1565C0"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Karyawan"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvIdKaryawan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#90CAF9"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Kartu form -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ubah Data Karyawan"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:layout_marginBottom="16dp" />

                <!-- Nama -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama Lengkap"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etNama"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Nama lengkap"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#BBBBBB"
                    android:textSize="15sp"
                    android:background="#F5F5F5"
                    android:paddingHorizontal="12dp"
                    android:layout_marginBottom="16dp" />

                <!-- Jabatan -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jabatan"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etJabatan"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Jabatan atau divisi"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#BBBBBB"
                    android:textSize="15sp"
                    android:background="#F5F5F5"
                    android:paddingHorizontal="12dp"
                    android:layout_marginBottom="16dp" />

                <!-- Toggle Status Aktif -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#F5F5F5"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status Aktif"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nonaktifkan untuk blokir presensi"
                            android:textSize="11sp"
                            android:textColor="#888888" />

                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchAktif"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>

            <!-- Tombol Simpan -->
            <Button
                android:id="@+id/btnSimpan"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Simpan Perubahan"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#1565C0"
                android:layout_marginBottom="10dp" />

            <!-- Tombol Hapus -->
            <Button
                android:id="@+id/btnHapus"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Hapus Karyawan"
                android:textSize="15sp"
                android:backgroundTint="#C62828" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>